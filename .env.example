# Token bearer cho MCP endpoint (openssl rand -hex 32)
MCP_TOKEN=change-me
PORT=8765

# --- Repo nao duoc phuc vu ---
# File khai bao repo tuong minh (quyen ghi, build/test cmd). Xem repos.example.json
REPOS_CONFIG=repos.json
# Thu muc chua nhieu repo: moi subdir co .git duoc tu dong nhan ra (chi doc)
WORKSPACE_ROOT=/home/you/mirrors
# Cho phep ghi vao repo tu dong tim thay? Mac dinh khong — muon ghi thi khai bao trong repos.json
AUTO_DISCOVERED_WRITE=false

# --- Ghi & git ---
# Prefix branch cho phep ghi, dung khi repo khong khai bao rieng
DEFAULT_BRANCH_PREFIX=agent/
# Kill switch toan cuc cho git_push (repo van phai co write: true)
ALLOW_PUSH=false
GIT_REMOTE=origin
# Tran kich thuoc cho create_file (bytes)
MAX_WRITE_BYTES=1000000

# --- Exec ---
EXEC_TIMEOUT_MS=900000
# Lenh index code graph mac dinh, chay trong tung repo
DEFAULT_REINDEX_CMD=npx gitnexus analyze
