# Token bearer cho MCP endpoint (openssl rand -hex 32)
MCP_TOKEN=change-me
PORT=8765
# Dia chi bind. Mac dinh 127.0.0.1 (chi may nay).
# Trong Docker phai la 0.0.0.0, khong thi container tu noi voi chinh no.
HOST=127.0.0.1

# --- Repo nao duoc phuc vu ---
# File khai bao repo tuong minh (quyen ghi, build/test cmd). Xem repos.example.json
REPOS_CONFIG=repos.json
# Thu muc chua nhieu repo: moi subdir co .git duoc tu dong nhan ra (chi doc)
WORKSPACE_ROOT=/home/you/mirrors
# Cho phep ghi vao repo tu dong tim thay? Mac dinh khong — muon ghi thi khai bao trong repos.json
AUTO_DISCOVERED_WRITE=false

# --- Ghi & git ---
# Prefix branch cho phep ghi, dung khi repo khong khai bao rieng
DEFAULT_BRANCH_PREFIX=agent/
# Kill switch toan cuc cho git_push (repo van phai co write: true)
ALLOW_PUSH=false
GIT_REMOTE=origin
# Tran kich thuoc cho create_file va edit_file (bytes)
MAX_WRITE_BYTES=1000000
# Tran kich thuoc cho read_file (bytes). File to hon thi bi tu choi doc.
MAX_READ_BYTES=2000000

# --- Exec ---
# Han cung cho mot lenh (build/test/reindex). Het han thi ca cay tien trinh bi giet.
EXEC_TIMEOUT_MS=900000
# run_build/run_tests cho toi day roi tu lui ve background va tra job_id.
# Phai nho hon EXEC_TIMEOUT_MS nhieu: client MCP se ngat truoc khi build 15 phut kip xong.
SYNC_WAIT_MS=60000
# Thoi gian toi da mot tool chiu xep hang cho repo ranh (dang co build chay chang han)
LOCK_WAIT_MS=120000
# Lenh index code graph mac dinh, chay trong tung repo.
# Duong dan co khoang trang thi boc trong dau ngoac kep.
DEFAULT_REINDEX_CMD=npx gitnexus analyze
