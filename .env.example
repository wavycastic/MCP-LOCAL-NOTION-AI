# Thu muc mirror repo — agent chi duoc dung vao day
REPO_ROOT=/home/you/mirrors/CV-AUT
# Token bearer cho MCP endpoint (openssl rand -hex 32)
MCP_TOKEN=change-me
PORT=8765
# Chi cho ghi/commit tren branch khop prefix nay
BRANCH_PREFIX=agent/
# Lenh build/test — hardcode, agent khong truyen duoc argv tuy y
BUILD_CMD=dotnet build --nologo -warnaserror
TEST_CMD=dotnet test --nologo
EXEC_TIMEOUT_MS=900000
