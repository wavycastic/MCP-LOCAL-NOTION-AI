# Token bearer cho MCP endpoint (openssl rand -hex 32)
MCP_TOKEN=change-me
PORT=8765
# Dia chi bind. Mac dinh 127.0.0.1 (chi may nay).
# Trong Docker phai la 0.0.0.0, khong thi container tu noi voi chinh no.
HOST=127.0.0.1

# --- Repo nao duoc phuc vu ---
# File khai bao repo tuong minh (quyen ghi, build/test cmd). Xem repos.example.json
REPOS_CONFIG=repos.json
# Thu muc chua nhieu repo: moi subdir co .git duoc tu dong nhan ra (chi doc)
WORKSPACE_ROOT=/home/you/mirrors
# Cho phep ghi vao repo tu dong tim thay? Mac dinh khong ? muon ghi thi khai bao trong repos.json
AUTO_DISCOVERED_WRITE=false

# --- Ghi & git ---
# Prefix branch cho phep ghi, dung khi repo khong khai bao rieng
DEFAULT_BRANCH_PREFIX=agent/
# Kill switch toan cuc cho git_push (repo van phai co write: true)
ALLOW_PUSH=false
GIT_REMOTE=origin
# Tran kich thuoc cho create_file va edit_file (bytes)
MAX_WRITE_BYTES=1000000
# Tran kich thuoc cho read_file (bytes). File to hon thi bi tu choi doc.
MAX_READ_BYTES=2000000

# --- Exec ---
# Han cung cho mot lenh (build/test/reindex). Het han thi ca cay tien trinh bi giet.
EXEC_TIMEOUT_MS=900000
# run_build/run_tests cho toi day roi tu lui ve background va tra job_id.
# Phai nho hon EXEC_TIMEOUT_MS nhieu: client MCP se ngat truoc khi build 15 phut kip xong.
SYNC_WAIT_MS=60000
# Thoi gian toi da mot tool chiu xep hang cho repo ranh (dang co build chay chang han)
LOCK_WAIT_MS=120000
# Lenh index code graph mac dinh, chay trong tung repo.
# Duong dan co khoang trang thi boc trong dau ngoac kep.
DEFAULT_REINDEX_CMD=npx gitnexus analyze
# Tran output cho mot lenh chay qua run() (bytes)
MAX_OUTPUT=200000

# ============================================================================
# TERMINAL ? agent chay lenh shell tuy y
#
# Day la nhom cong tac nguy hiem nhat trong ca file. Bat ALLOW_TERMINAL nghia la
# bat ky ai co MCP_TOKEN deu chay duoc lenh bat ky voi quyen cua tien trinh server.
# ============================================================================
# Kill switch tong. Mac dinh false.
ALLOW_TERMINAL=false
# disabled | repo | full
#   repo = chi chay trong thu muc cua mot repo that
#   full = cho phep ca repo ao "system" (can ALLOW_FULL_ACCESS=true)
TERMINAL_MODE=repo
# true = KHONG loc bien bi mat khoi env cua tien trinh con. De false tru khi buoc phai.
TERMINAL_INHERIT_SECRETS=false
TERMINAL_MAX_COMMAND_CHARS=20000
TERMINAL_MAX_OUTPUT_BYTES=200000

# --- PTY (terminal_start / terminal_write / terminal_read) ---
PTY_MAX_SESSIONS=8
PTY_BUFFER_BYTES=1000000
PTY_READ_MAX_BYTES=100000
PTY_MAX_INPUT_CHARS=100000
PTY_IDLE_TIMEOUT_MS=1800000
PTY_MAX_LIFETIME_MS=14400000
# true = mot PTY session giu DOC QUYEN repo suot doi no (hanh vi cu, hay gay nghen:
# moi tool ghi khac xep hang roi chet vi LOCK_WAIT_MS). Mac dinh false.
PTY_HOLD_LOCK=false

# ============================================================================
# FULL READ / FULL ACCESS ? doc (va tuy chon ghi) toan may cuc bo
#
# ALLOW_FULL_READ=true: them repo ao "system" CHI DOC. Dung repo="system"
# voi duong dan tuyet doi (C:\..., E:\...). Deny-list VAN ap dung (.env,
# SSH keys, *.pem). Khong can khai bao tung thu muc trong repos.json.
#
# ALLOW_FULL_ACCESS=true: ke thua full-read, MO GHI, va TAT deny-list.
# Agent doc/sua duoc .env, .ssh/id_rsa, *.pem. Chi bat tren may ca nhan,
# va dung bao gio mo tunnel ra ngoai khi dang bat no.
# ============================================================================
ALLOW_FULL_READ=false
ALLOW_FULL_ACCESS=false
# Thu muc lam viec cho repo ao "system". Bo trong = process.cwd()
# FULL_ACCESS_CWD=

# ============================================================================
# TOOL SURFACE ? chon bao nhieu tool duoc lo ra cho client
# ============================================================================
# full  = tat ca (mac dinh)
# core  = bo bot tool destructive/openWorld it dung
# safe  = bo moi tool destructive, openWorld va git_push
# agent = bo mat toi thieu cho agent tu dong
TOOL_PROFILE=full

# ============================================================================
# ANTIGRAVITY SUB-AGENT - giao viec cho sub-agent Antigravity CLI (agy)
#
# Kill switch cho bo tool antigravity_*. Mac dinh true.
ANTIGRAVITY_ENABLE=true
# Mo cua so Terminal tuong tac nguyen ban ngay tren man hinh khi spawn sub-agent. Mac dinh true.
ANTIGRAVITY_INTERACTIVE=true
# Duong dan binary agy. Mac dinh LOCALAPPDATA\agy\bin\agy.exe tren Windows,
# ~/.local/bin/agy tren macOS va Linux.
# ANTIGRAVITY_CLI_BIN=
# Slug model, xem day du bang lenh: agy models
ANTIGRAVITY_MODEL=gemini-3.6-flash-medium
# Tu duyet moi tool (--dangerously-skip-permissions).
ANTIGRAVITY_SKIP_PERMISSIONS=false
# Tran cho mot lan chay, map sang --print-timeout.
# ANTIGRAVITY_TASK_TIMEOUT_MS=900000
# Cho su kien init dau tien - luc do moi biet conversation_id.
# ANTIGRAVITY_START_TIMEOUT_MS=60000
